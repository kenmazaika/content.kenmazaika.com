---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import CodeCopyScript from '../components/CodeCopyScript.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { slug: string; readingMinutes?: number };
const { title, description, pubDate, updatedDate, slug, seoTitle, socialTitle, readingMinutes = 1, hideDefaultNewsletter = false, noindex = false, related = [], faq = [], ogCategory } = Astro.props;
const socialImage = `/og/${slug}.png`;
const socialImageAlt = `${socialTitle ?? title} — Publish`;
const pageTitle = `${seoTitle ?? title} — ${SITE_TITLE}`;
const canonicalURL = new URL(`/blog/${slug}/`, Astro.site);
const category = ogCategory?.split('·').pop()?.trim() ?? 'Field Note';
const articleSchema = {
	'@context': 'https://schema.org', '@type': 'BlogPosting', headline: title, description,
	image: new URL(socialImage, Astro.site).href,
	author: { '@type': 'Person', name: 'Ken Mazaika', url: new URL('/about/', Astro.site).href },
	publisher: { '@type': 'Organization', name: 'Publish', url: Astro.site?.href },
	datePublished: pubDate.toISOString(), ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}), mainEntityOfPage: canonicalURL.href,
};
const faqSchema = faq?.length ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) } : null;
---
<!doctype html>
<html lang="en">
<head>
	<BaseHead title={pageTitle} description={description} image={socialImage} imageAlt={socialImageAlt} type="article" noindex={noindex} />
	<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
	{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
	<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Libre+Caslon+Display&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet" />
</head>
<body>
	<Header />
	<main class="article-page"><article>
		<header class="article-header">
			<p class="article-section"><span>{category}</span><a href="/blog">← Archive</a></p>
			<h1>{title}</h1>
			{description && <p class="article-deck">{description}</p>}
			<p class="article-byline"><span>Ken Mazaika</span><span><FormattedDate date={pubDate} /></span><span>{readingMinutes} min read</span>{updatedDate && <span>Updated <FormattedDate date={updatedDate} /></span>}</p>
		</header>
		<div class="article-body"><div class="prose"><slot /></div></div>
		{related.length > 0 && <nav class="related-posts" aria-label="Related reading"><p class="section-kicker">Continue reading</p><h2>Related essays</h2><ol>{related.map((item) => <li><a href={item.url}>{item.title}</a></li>)}</ol></nav>}
		{!hideDefaultNewsletter && <NewsletterSignup />}
		<footer class="article-footer"><p><span>About the author</span><strong>Ken Mazaika</strong> writes about content systems, distribution, and the practical use of AI agents in publishing.</p><a href="/blog">Browse the archive →</a></footer>
	</article></main>
	<Footer /><CodeCopyScript />
</body>
</html>
